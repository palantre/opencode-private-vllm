#!/usr/bin/env bash
set -euo pipefail

PROGRAM=${0##*/}
CONFIG_DIR=${OPENCODE_GPU_CONFIG_DIR:-"${XDG_CONFIG_HOME:-$HOME/.config}/opencode-gpu"}
STATE_DIR=${OPENCODE_GPU_STATE_DIR:-"$HOME/.local/state/opencode-gpu"}
CONFIG_FILE=${OPENCODE_GPU_CONFIG_FILE:-"$CONFIG_DIR/config"}
KEY_FILE=${OPENCODE_GPU_KEY_FILE:-"$CONFIG_DIR/vllm-api-key"}
STATE_FILE="$STATE_DIR/state.json"
LOCK_FILE="$STATE_DIR/lifecycle.lock"
MONITOR_LOG="$STATE_DIR/monitor.log"

RUNPOD_POD_NAME=opencode-private-gpu
RUNPOD_IMAGE=ghcr.io/palantre/opencode-private-vllm@sha256:762842bfb0158318d7aafea41e03c47b0ebe24f19be5180025011a3f88994d4f
RUNPOD_LLAMA_CPP_IMAGE=ghcr.io/palantre/opencode-private-llama-cpp@sha256:6e537638330caf17d52f794a863552332d437cf78c199f51adf891295fe51473
RUNPOD_FORCE_LLAMA_CPP=0
RUNPOD_CLINICAL_MODE=1
RUNPOD_CLINICAL_APPROVED_IMAGE_DIGESTS=${RUNPOD_CLINICAL_APPROVED_IMAGE_DIGESTS:-762842bfb0158318d7aafea41e03c47b0ebe24f19be5180025011a3f88994d4f,6e537638330caf17d52f794a863552332d437cf78c199f51adf891295fe51473}
RUNPOD_REGISTRY_AUTH_ID=
RUNPOD_GPU_IDS='NVIDIA L40S,NVIDIA RTX 6000 Ada Generation,NVIDIA L40,NVIDIA GeForce RTX 5090,NVIDIA GeForce RTX 4090,NVIDIA A100 80GB PCIe,NVIDIA A100-SXM4-80GB'
RUNPOD_DATA_CENTER_IDS=
RUNPOD_ALLOWED_DC_PREFIXES='EU-,EUR-'
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_VOLUME_GB=0
RUNPOD_MAX_SESSION_MINUTES=240
RUNPOD_MAX_PRICE_PER_HOUR=1.50
RUNPOD_MIN_DOWNLOAD_MBPS=${RUNPOD_MIN_DOWNLOAD_MBPS:-100}
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
VLLM_SERVED_MODEL=qwen3.8-27b-fp8
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=16
VLLM_KV_CACHE_DTYPE=fp8
LLAMA_CPP_MODEL=Chungulus/Qwen3.8-27B-Q4_K_M-GGUF
LLAMA_CPP_REVISION=5ae8e19376c871fd4fccd956a967f58b1598c8aa
LLAMA_CPP_MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf
LLAMA_CPP_MODEL_SHA256=115a859329b5f4e876bed5ed49225d8097d055783a81945004a80af2fb2703f8
LLAMA_CPP_CONTEXT_SIZE=32768
LLAMA_CPP_5090_CONTEXT_SIZE=32768
LLAMA_CPP_4090_CONTEXT_SIZE=32768
LLAMA_CPP_PARALLEL=1
LLAMA_CPP_CACHE_TYPE=q8_0
VLLM_LOCAL_PORT=18000
VLLM_REMOTE_PORT=8000
VLLM_IDLE_MINUTES=30
MONITOR_INTERVAL_SECONDS=${OPENCODE_GPU_MONITOR_INTERVAL_SECONDS:-60}
HEALTH_TIMEOUT_SECONDS=${OPENCODE_GPU_HEALTH_TIMEOUT_SECONDS:-1200}
LLAMA_CPP_HEALTH_TIMEOUT_SECONDS=${OPENCODE_GPU_LLAMA_CPP_HEALTH_TIMEOUT_SECONDS:-${OPENCODE_GPU_HEALTH_TIMEOUT_SECONDS:-3600}}
RECONCILE_ATTEMPTS=${OPENCODE_GPU_RECONCILE_ATTEMPTS:-12}
RECONCILE_INTERVAL_SECONDS=${OPENCODE_GPU_RECONCILE_INTERVAL_SECONDS:-5}

[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*" >&2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

read_key() {
  [[ -r "$KEY_FILE" ]] || die "Missing local provider key: $KEY_FILE. Run install.sh first."
  VLLM_API_KEY=$(<"$KEY_FILE")
  [[ -n "$VLLM_API_KEY" ]] || die "The local provider key is empty: $KEY_FILE"
}

state_value() {
  jq -er "$1" "$STATE_FILE" 2>/dev/null
}

pod_id() {
  state_value '.pod_id // empty'
}

pid_alive() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && kill -0 "$1" 2>/dev/null
}

pid_matches() {
  local pid=${1:-} pattern=${2:-}
  pid_alive "$pid" && [[ -r "/proc/$pid/cmdline" ]] && grep -aq -- "$pattern" "/proc/$pid/cmdline"
}

write_state() {
  local content=$1 tmp
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/state.XXXXXX")
  printf '%s\n' "$content" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$STATE_FILE"
}

update_state() {
  local filter=$1 tmp
  shift
  tmp=$(mktemp "$STATE_DIR/state.XXXXXX")
  jq "$filter" "$@" "$STATE_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$STATE_FILE"
}

runpod() {
  runpodctl "$@"
}

runpod_config_value() {
  local wanted=$1 config_file=${RUNPOD_CONFIG_FILE:-"$HOME/.runpod/config.toml"} line key value quote
  [[ -r "$config_file" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    key=${line%%=*}
    key=${key#"${key%%[![:space:]]*}"}
    key=${key%"${key##*[![:space:]]}"}
    [[ "$key" == "$wanted" ]] || continue
    value=${line#*=}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    quote=${value:0:1}
    if [[ "$quote" == "'" || "$quote" == '"' ]]; then
      [[ "${value: -1}" == "$quote" ]] || return 1
      value=${value:1:${#value}-2}
    fi
    [[ -n "$value" ]] || return 1
    printf '%s\n' "$value"
    return 0
  done < "$config_file"
  return 1
}

runpod_api_key() {
  if [[ -n "${RUNPOD_API_KEY:-}" ]]; then
    printf '%s\n' "$RUNPOD_API_KEY"
  else
    runpod_config_value apikey
  fi
}

runpod_graphql_url() {
  local configured
  if [[ -n "${RUNPOD_GRAPHQL_URL:-}" ]]; then
    printf '%s\n' "$RUNPOD_GRAPHQL_URL"
  elif configured=$(runpod_config_value apiurl 2>/dev/null) || configured=$(runpod_config_value apiUrl 2>/dev/null); then
    printf '%s\n' "$configured"
  else
    printf '%s\n' 'https://api.runpod.io/graphql'
  fi
}

create_pod_graphql() {
  local gpu=$1 dc=$2 terminate_after=$3 env_json=$4 pod_name=$5 api_key graphql_url query input payload response
  local curl_error curl_status error_code message
  api_key=$(runpod_api_key) || {
    jq -cn '{error:"Runpod API key is not configured",code:"no_credentials"}' >&2
    return 1
  }
  graphql_url=$(runpod_graphql_url)
  query='mutation createPod($input: PodFindAndDeployOnDemandInput!) { podFindAndDeployOnDemand(input: $input) { id } }'
  input=$(jq -cn \
    --arg gpu "$gpu" --arg dc "$dc" --arg image "$PROFILE_IMAGE" --arg name "$pod_name" \
    --arg terminate "$terminate_after" --arg mount /workspace --arg network "$RUNPOD_NETWORK_VOLUME_ID" \
    --arg registry "$RUNPOD_REGISTRY_AUTH_ID" --argjson disk "$RUNPOD_CONTAINER_DISK_GB" \
    --argjson volume "$RUNPOD_VOLUME_GB" --argjson min_download "$RUNPOD_MIN_DOWNLOAD_MBPS" \
    --argjson env "$env_json" \
    '{cloudType:"SECURE",containerDiskInGb:$disk,gpuCount:1,gpuTypeId:$gpu,imageName:$image,name:$name,
      ports:"22/tcp",startSsh:true,dataCenterId:$dc,terminateAfter:$terminate,minDownload:$min_download,
      env:($env | to_entries | map({key:.key,value:(.value | tostring)}))}
      + (if $network != "" then {networkVolumeId:$network,volumeMountPath:$mount}
         elif $volume > 0 then {volumeInGb:$volume,volumeMountPath:$mount} else {} end)
      + (if $registry != "" then {containerRegistryAuthId:$registry} else {} end)')
  payload=$(jq -cn --arg query "$query" --argjson input "$input" '{query:$query,variables:{input:$input}}')
  curl_error=$(mktemp "$STATE_DIR/graphql.XXXXXX")
  if response=$(curl --disable --silent --show-error --fail-with-body --max-time 30 \
      -H @<(printf 'Authorization: Bearer %s\n' "$api_key") -H 'Content-Type: application/json' \
      --data-binary "$payload" "$graphql_url" 2>"$curl_error"); then
    :
  else
    curl_status=$?
    message=$(jq -r '.errors[0].message // empty' <<< "$response" 2>/dev/null || true)
    [[ -n "$message" ]] || message=$(<"$curl_error")
    rm -f "$curl_error"
    case "$curl_status" in
      1|2|3|4|5|6|7|35|43|48|49|60|77|82|83|90|91) error_code=graphql_unreachable ;;
      *) error_code=graphql_ambiguous ;;
    esac
    jq -cn --arg error "${message:-GraphQL request failed}" --arg code "$error_code" \
      '{error:$error,code:$code}' >&2
    return 1
  fi
  rm -f "$curl_error"
  if jq -e '.data.podFindAndDeployOnDemand.id' >/dev/null 2>&1 <<< "$response"; then
    jq -c '.data.podFindAndDeployOnDemand' <<< "$response"
    return 0
  fi
  message=$(jq -r '.errors[0].message // empty' <<< "$response")
  if [[ -n "$message" ]]; then
    if [[ "$message" == *'There are no longer any instances available with the requested specifications'* ]]; then
      jq -cn --arg error "$message" '{error:$error,code:"graphql_rejected"}' >&2
    else
      jq -cn --arg error "$message" '{error:$error,code:"graphql_ambiguous"}' >&2
    fi
  else
    jq -cn '{error:"Pod creation returned no id",code:"graphql_ambiguous"}' >&2
  fi
  return 1
}

validate_min_download() {
  [[ "$RUNPOD_MIN_DOWNLOAD_MBPS" =~ ^(0|[1-9][0-9]{0,9})$ ]] &&
    (( 10#$RUNPOD_MIN_DOWNLOAD_MBPS <= 2147483647 )) ||
    die "RUNPOD_MIN_DOWNLOAD_MBPS must be an integer from 0 to 2147483647 without leading zeros."
}

validate_reconcile_settings() {
  [[ "$RECONCILE_ATTEMPTS" =~ ^[1-9][0-9]?$ ]] ||
    die "OPENCODE_GPU_RECONCILE_ATTEMPTS must be an integer from 1 to 99."
  [[ "$RECONCILE_INTERVAL_SECONDS" =~ ^(0|[1-9][0-9]{0,2})$ ]] ||
    die "OPENCODE_GPU_RECONCILE_INTERVAL_SECONDS must be an integer from 0 to 999 without leading zeros."
}

validate_clinical_mode() {
  local image_digest
  [[ "$RUNPOD_CLINICAL_MODE" == 0 || "$RUNPOD_CLINICAL_MODE" == 1 ]] ||
    die "RUNPOD_CLINICAL_MODE must be 0 or 1."
  if [[ "$RUNPOD_CLINICAL_MODE" == 1 ]]; then
    image_digest=${PROFILE_IMAGE##*@sha256:}
    case ",${RUNPOD_CLINICAL_APPROVED_IMAGE_DIGESTS}," in
      *,"$image_digest",*) ;;
      *) die "Clinical mode rejected an inference image without an approved clinical-controls digest." ;;
    esac
  fi
  if [[ "$RUNPOD_CLINICAL_MODE" == 1 && -n "$RUNPOD_NETWORK_VOLUME_ID" && "$PROFILE_ENGINE" != llama_cpp ]]; then
    die "Clinical mode permits a network volume only with the read-only llama.cpp model-cache profile."
  fi
}

reconcile_graphql_create() {
  local pod_name=$1 attempt pods id found=0 deletion_failed=0
  for ((attempt = 1; attempt <= RECONCILE_ATTEMPTS; attempt++)); do
    if ! pods=$(runpod pod list --all 2>/dev/null); then
      (( attempt < RECONCILE_ATTEMPTS )) && sleep "$RECONCILE_INTERVAL_SECONDS"
      continue
    fi
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      found=1
      note "Ambiguous GraphQL result created Pod $id; terminating it..."
      if ! delete_pod "$id"; then
        deletion_failed=1
        update_state '.pod_id = $id' --arg id "$id"
      fi
    done < <(jq -r --arg name "$pod_name" '(.pods? // .)[]? | select(.name == $name) | .id' <<< "$pods" 2>/dev/null)
    (( found == 1 )) && (( deletion_failed == 0 )) && return 0
    (( attempt < RECONCILE_ATTEMPTS )) && sleep "$RECONCILE_INTERVAL_SECONDS"
  done
  return 1
}

pending_pod_absent() {
  local pod_name=$1 pods
  pods=$(runpod pod list --all 2>/dev/null) || return 1
  ! jq -e --arg name "$pod_name" '(.pods? // .)[]? | select(.name == $name)' >/dev/null <<< "$pods"
}

stock_available() {
  local value=${1,,}
  case "$value" in
    ''|none|unavailable|'out of stock'|'no stock') return 1 ;;
    *) return 0 ;;
  esac
}

configure_llama_cpp_profile() {
  local gpu=$1
  PROFILE_SERVED_MODEL=$VLLM_SERVED_MODEL
  PROFILE_ENGINE=llama_cpp
  PROFILE_IMAGE=$RUNPOD_LLAMA_CPP_IMAGE
  PROFILE_MODEL=$LLAMA_CPP_MODEL
  PROFILE_REVISION=$LLAMA_CPP_REVISION
  PROFILE_MAX_MODEL_LEN=$LLAMA_CPP_CONTEXT_SIZE
  PROFILE_PARALLEL=$LLAMA_CPP_PARALLEL
  PROFILE_LOG_FILE=/var/log/opencode-gpu/llama-cpp.log
  case "$gpu" in
    'NVIDIA GeForce RTX 5090') PROFILE_MAX_MODEL_LEN=$LLAMA_CPP_5090_CONTEXT_SIZE ;;
    'NVIDIA GeForce RTX 4090') PROFILE_MAX_MODEL_LEN=$LLAMA_CPP_4090_CONTEXT_SIZE ;;
  esac
}

configure_profile() {
  local gpu=$1
  PROFILE_SERVED_MODEL=$VLLM_SERVED_MODEL
  [[ "$RUNPOD_FORCE_LLAMA_CPP" == 0 || "$RUNPOD_FORCE_LLAMA_CPP" == 1 ]] ||
    die "RUNPOD_FORCE_LLAMA_CPP must be 0 or 1."
  if [[ "$RUNPOD_FORCE_LLAMA_CPP" == 1 ]]; then
    case "$gpu" in
      'NVIDIA GeForce RTX 5090'|'NVIDIA GeForce RTX 4090'|'NVIDIA RTX PRO 4500 Blackwell'|'NVIDIA RTX 6000 Ada Generation'|'NVIDIA L40'|'NVIDIA L40S'|'NVIDIA RTX A6000'|'NVIDIA A100 80GB PCIe'|'NVIDIA A100-SXM4-80GB')
        configure_llama_cpp_profile "$gpu"
        return
        ;;
    esac
  fi
  case "$gpu" in
    'NVIDIA GeForce RTX 5090'|'NVIDIA GeForce RTX 4090')
      configure_llama_cpp_profile "$gpu"
      ;;
    'NVIDIA A100 80GB PCIe'|'NVIDIA A100-SXM4-80GB')
      PROFILE_ENGINE=vllm
      PROFILE_IMAGE=$RUNPOD_IMAGE
      PROFILE_MODEL=$VLLM_MODEL
      PROFILE_REVISION=$VLLM_REVISION
      PROFILE_MAX_MODEL_LEN=$VLLM_MAX_MODEL_LEN
      PROFILE_MAX_NUM_SEQS=$VLLM_MAX_NUM_SEQS
      PROFILE_KV_CACHE_DTYPE=auto
      PROFILE_LOG_FILE=/var/log/opencode-gpu/vllm.log
      ;;
    'NVIDIA L40S'|'NVIDIA RTX 6000 Ada Generation'|'NVIDIA L40'|'NVIDIA RTX PRO 6000 Blackwell Server Edition MIG 2g.48gb')
      PROFILE_ENGINE=vllm
      PROFILE_IMAGE=$RUNPOD_IMAGE
      PROFILE_MODEL=$VLLM_MODEL
      PROFILE_REVISION=$VLLM_REVISION
      PROFILE_MAX_MODEL_LEN=$VLLM_MAX_MODEL_LEN
      PROFILE_MAX_NUM_SEQS=$VLLM_MAX_NUM_SEQS
      PROFILE_KV_CACHE_DTYPE=$VLLM_KV_CACHE_DTYPE
      PROFILE_LOG_FILE=/var/log/opencode-gpu/vllm.log
      ;;
    *) die "No inference profile is defined for GPU: $gpu" ;;
  esac
}

validate_profile_image() {
  [[ "$PROFILE_IMAGE" != *CHANGE_ME* && "$PROFILE_IMAGE" != *UNPUBLISHED* ]] || \
    die "Set the published image for the selected $PROFILE_ENGINE profile in $CONFIG_FILE."
  [[ "$PROFILE_IMAGE" =~ @sha256:[0-9a-fA-F]{64}$ ]] || \
    die "Pin the selected $PROFILE_ENGINE image to an immutable sha256 manifest digest."
}

profile_image_valid() {
  [[ "$PROFILE_IMAGE" != *CHANGE_ME* && "$PROFILE_IMAGE" != *UNPUBLISHED* ]] && \
    [[ "$PROFILE_IMAGE" =~ @sha256:[0-9a-fA-F]{64}$ ]]
}

dc_allowed() {
  local dc=$1 prefix
  IFS=',' read -ra allowed_prefixes <<< "$RUNPOD_ALLOWED_DC_PREFIXES"
  for prefix in "${allowed_prefixes[@]}"; do
    [[ -n "$prefix" && "$dc" == "$prefix"* ]] && return 0
  done
  return 1
}

select_gpu() {
  local inventory preference candidate gpu dc price stock allowed invalid_image=0
  inventory=$(runpod gpu list --include-unavailable)
  IFS=',' read -ra preferences <<< "$RUNPOD_GPU_IDS"

  for preference in "${preferences[@]}"; do
    preference=${preference#"${preference%%[![:space:]]*}"}
    preference=${preference%"${preference##*[![:space:]]}"}
    while IFS=$'\t' read -r gpu dc price stock; do
      [[ -n "$gpu" && -n "$dc" && "$price" != null ]] || continue
      dc_allowed "$dc" || continue
      stock_available "$stock" || continue
      if [[ -n "$RUNPOD_DATA_CENTER_IDS" ]]; then
        allowed=0
        IFS=',' read -ra configured_dcs <<< "$RUNPOD_DATA_CENTER_IDS"
        for candidate in "${configured_dcs[@]}"; do
          [[ "$dc" == "$candidate" ]] && allowed=1
        done
        (( allowed == 1 )) || continue
      fi
      jq -en --argjson price "$price" --argjson ceiling "$RUNPOD_MAX_PRICE_PER_HOUR" \
        '$price <= $ceiling' | grep -qx true || continue
      configure_profile "$gpu"
      if ! profile_image_valid; then
        invalid_image=1
        continue
      fi
      printf '%s\t%s\t%s\n' "$gpu" "$dc" "$price"
      return 0
    done < <(
      jq -r --arg wanted "$preference" '
        (.gpus? // .)[]
        | select(.gpuId == $wanted and .secureCloud == true)
        | . as $gpu
        | ($gpu.dataCenterAvailability // [])[]
        | [$gpu.gpuId, .dataCenterId, $gpu.securePricePerHr, (.stockStatus // "none")]
        | @tsv
      ' <<< "$inventory"
    )
  done
  (( invalid_image == 0 )) || return 2
  return 1
}

ssh_info() {
  local info
  info=$(runpod ssh info "$(pod_id)")
  [[ $(jq -r '.error // empty' <<< "$info") == '' ]] || return 1
  jq -e '.ip and .port' >/dev/null <<< "$info" || return 1
  printf '%s\n' "$info"
}

pin_to_network_volume() {
  local volume
  NETWORK_VOLUME_DC=
  NETWORK_VOLUME_SIZE_GB=null
  [[ -n "$RUNPOD_NETWORK_VOLUME_ID" ]] || return 0

  volume=$(runpod network-volume get "$RUNPOD_NETWORK_VOLUME_ID") || die "Could not read network volume $RUNPOD_NETWORK_VOLUME_ID."
  NETWORK_VOLUME_DC=$(jq -er '.dataCenterId // .dataCenter.id' <<< "$volume") || die "Could not determine the network volume datacenter."
  NETWORK_VOLUME_SIZE_GB=$(jq -r '.size // "null"' <<< "$volume")
  dc_allowed "$NETWORK_VOLUME_DC" || die "The network volume is not in an allowed EU/EEA datacenter: $NETWORK_VOLUME_DC"
  [[ -z "$RUNPOD_DATA_CENTER_IDS" || "$RUNPOD_DATA_CENTER_IDS" == "$NETWORK_VOLUME_DC" ]] || \
    die "RUNPOD_DATA_CENTER_IDS does not match the network volume datacenter $NETWORK_VOLUME_DC."
  RUNPOD_DATA_CENTER_IDS=$NETWORK_VOLUME_DC
}

ssh_args() {
  local info=$1 key_path host port
  host=$(jq -r '.ip' <<< "$info")
  port=$(jq -r '.port' <<< "$info")
  key_path=$(jq -r '.ssh_key.private_key_path // .ssh_key.path // empty' <<< "$info")
  touch "$STATE_DIR/known_hosts"
  chmod 600 "$STATE_DIR/known_hosts"
  ssh-keygen -R "[$host]:$port" -f "$STATE_DIR/known_hosts" >/dev/null 2>&1 || true
  SSH_ARGS=(
    -p "$port"
    -o BatchMode=yes
    -o StrictHostKeyChecking=accept-new
    -o "UserKnownHostsFile=$STATE_DIR/known_hosts"
    -o ConnectTimeout=10
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
  )
  [[ -z "$key_path" ]] || SSH_ARGS+=(-i "$key_path")
  SSH_TARGET="root@$host"
}

start_tunnel() {
  local info tunnel_pid
  info=$(ssh_info) || die "Pod SSH information is unavailable."
  ssh_args "$info"
  ssh "${SSH_ARGS[@]}" \
    -o ExitOnForwardFailure=yes \
    -N -L "${VLLM_LOCAL_PORT}:127.0.0.1:${VLLM_REMOTE_PORT}" \
    "$SSH_TARGET" >>"$STATE_DIR/tunnel.log" 2>&1 &
  tunnel_pid=$!
  sleep 2
  pid_alive "$tunnel_pid" || die "SSH tunnel failed; see $STATE_DIR/tunnel.log"
  update_state '.tunnel_pid = $pid' --argjson pid "$tunnel_pid"
}

wait_for_ssh() {
  local deadline=$((SECONDS + 1200)) info
  note "Waiting up to 1200s for Pod SSH..."
  while :; do
    if info=$(ssh_info 2>/dev/null); then
      ssh_args "$info"
      ssh "${SSH_ARGS[@]}" "$SSH_TARGET" true >/dev/null 2>&1 && return 0
    fi
    (( SECONDS < deadline )) || die "Pod SSH did not become available within 1200s."
    sleep 10
  done
}

wait_for_server() {
  local health_timeout deadline
  if [[ "$PROFILE_ENGINE" == llama_cpp ]]; then
    health_timeout=$LLAMA_CPP_HEALTH_TIMEOUT_SECONDS
  else
    health_timeout=$HEALTH_TIMEOUT_SECONDS
  fi
  deadline=$((SECONDS + health_timeout))
  read_key
  note "Waiting up to ${health_timeout}s for $PROFILE_ENGINE model readiness..."
  until curl --silent --show-error --fail --max-time 10 \
      -H "Authorization: Bearer $VLLM_API_KEY" \
      "http://127.0.0.1:${VLLM_LOCAL_PORT}/v1/models" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || die "$PROFILE_ENGINE did not become ready within ${health_timeout}s."
    pid_alive "$(state_value '.tunnel_pid' || true)" || die "SSH tunnel exited while waiting for $PROFILE_ENGINE."
    sleep 10
  done
}

capture_startup_failure() {
  local id info log_file
  cp "$STATE_FILE" "$STATE_DIR/startup-failure-state.json" 2>/dev/null || true
  id=$(pod_id || true)
  [[ -z "$id" ]] || runpod pod logs "$id" --since 30m >"$STATE_DIR/startup-failure.log" 2>&1 || true
  info=$(ssh_info 2>/dev/null || true)
  [[ -n "$info" ]] || return 0
  ssh_args "$info"
  log_file=$(state_value '.log_file // "/var/log/opencode-gpu/vllm.log"' || true)
  ssh "${SSH_ARGS[@]}" "$SSH_TARGET" tail -c 200000 -- "$log_file" \
    >"$STATE_DIR/startup-failure-remote.log" 2>&1 || true
}

start_monitor() {
  "$0" _monitor >>"$MONITOR_LOG" 2>&1 &
  local monitor_pid=$!
  update_state '.monitor_pid = $pid' --argjson pid "$monitor_pid"
}

delete_pod() {
  local id=$1 attempt output error_file error_json code
  error_file=$(mktemp "$STATE_DIR/delete.XXXXXX")
  for attempt in 1 2 3; do
    if output=$(runpod pod delete "$id" 2>"$error_file"); then
      rm -f "$error_file"
      return 0
    fi
    error_json=$(jq -Rn '[inputs | fromjson? | select(type == "object")] | first // {}' < "$error_file")
    code=$(jq -r '.code // "unknown"' <<< "$error_json")
    case "$code" in
      not_found)
        rm -f "$error_file"
        return 0
        ;;
      network_error|rate_limited|server_error|api_error|graphql_error)
        (( attempt < 3 )) && sleep $((attempt * 2))
        ;;
      *)
        note "Runpod deletion failed: $(jq -r '.error // "unknown error"' <<< "$error_json")"
        rm -f "$error_file"
        return 1
        ;;
    esac
  done
  rm -f "$error_file"
  return 1
}

up() {
  local selection gpu dc price terminate_after env_json output id cache_dir create_error error_json error_code pod_name started
  require_command runpodctl
  require_command jq
  require_command ssh
  require_command curl
  read_key
  validate_min_download
  validate_reconcile_settings
  (( RUNPOD_MIN_DOWNLOAD_MBPS == 0 )) || runpod_api_key >/dev/null ||
    die "Runpod API key is not configured. Set RUNPOD_API_KEY or run runpodctl doctor."
  pin_to_network_volume

  [[ ! -r "$STATE_FILE" ]] || die "Local lifecycle state already exists. Run '$PROGRAM status' or '$PROGRAM down'."

  selection=$(select_gpu) || {
    (( $? == 2 )) && die "In-stock preferred GPUs were found, but none has a configured immutable engine image."
    die "No preferred Secure Cloud GPU is in stock in an allowed EU/EEA datacenter below the price ceiling."
  }
  IFS=$'\t' read -r gpu dc price <<< "$selection"
  configure_profile "$gpu"
  validate_profile_image
  validate_clinical_mode
  terminate_after=$(date -u -d "+${RUNPOD_MAX_SESSION_MINUTES} minutes" +%Y-%m-%dT%H:%M:%SZ)
  if [[ "$PROFILE_ENGINE" == vllm ]]; then
    cache_dir=/root/.cache/huggingface
    [[ "$RUNPOD_CLINICAL_MODE" == 0 ]] || cache_dir=/var/lib/opencode-gpu/huggingface
    [[ -z "$RUNPOD_NETWORK_VOLUME_ID" ]] || cache_dir=/workspace/huggingface
    env_json=$(jq -cn \
      --arg model "$PROFILE_MODEL" --arg revision "$PROFILE_REVISION" \
      --arg served "$PROFILE_SERVED_MODEL" --arg port "$VLLM_REMOTE_PORT" \
      --arg maxlen "$PROFILE_MAX_MODEL_LEN" --arg maxseqs "$PROFILE_MAX_NUM_SEQS" \
      --arg cache "$cache_dir" --arg kv "$PROFILE_KV_CACHE_DTYPE" --arg clinical "$RUNPOD_CLINICAL_MODE" \
      '{MODEL_ID:$model,MODEL_REVISION:$revision,SERVED_MODEL_NAME:$served,SERVER_PORT:$port,MAX_MODEL_LEN:$maxlen,MAX_NUM_SEQS:$maxseqs,MODEL_CACHE_DIR:$cache,KV_CACHE_DTYPE:$kv,CLINICAL_MODE:$clinical}')
  else
    cache_dir=/root/.cache/llama.cpp
    [[ "$RUNPOD_CLINICAL_MODE" == 0 ]] || cache_dir=/var/lib/opencode-gpu/llama.cpp
    [[ -z "$RUNPOD_NETWORK_VOLUME_ID" ]] || cache_dir=/workspace/llama.cpp
    env_json=$(jq -cn \
      --arg url "https://huggingface.co/${LLAMA_CPP_MODEL}/resolve/${PROFILE_REVISION}/${LLAMA_CPP_MODEL_FILE}" \
      --arg file "$LLAMA_CPP_MODEL_FILE" --arg sha "$LLAMA_CPP_MODEL_SHA256" \
      --arg served "$PROFILE_SERVED_MODEL" --arg port "$VLLM_REMOTE_PORT" \
      --arg context "$PROFILE_MAX_MODEL_LEN" --arg parallel "$PROFILE_PARALLEL" \
      --arg cache "$cache_dir" --arg cache_type "$LLAMA_CPP_CACHE_TYPE" --arg clinical "$RUNPOD_CLINICAL_MODE" \
      '{MODEL_URL:$url,MODEL_FILE:$file,MODEL_SHA256:$sha,SERVED_MODEL_NAME:$served,SERVER_PORT:$port,CONTEXT_SIZE:$context,PARALLEL:$parallel,MODEL_CACHE_DIR:$cache,CACHE_TYPE:$cache_type,CLINICAL_MODE:$clinical}')
  fi

  create_args=(pod create --name "$RUNPOD_POD_NAME" --image "$PROFILE_IMAGE" --gpu-id "$gpu"
    --gpu-count 1 --cloud-type SECURE --data-center-ids "$dc" --ports 22/tcp
    --container-disk-in-gb "$RUNPOD_CONTAINER_DISK_GB" --env "$env_json"
    --terminate-after "$terminate_after" --ssh --wait --wait-timeout 20m)
  if [[ -n "$RUNPOD_NETWORK_VOLUME_ID" ]]; then
    create_args+=(--network-volume-id "$RUNPOD_NETWORK_VOLUME_ID" --volume-mount-path /workspace)
  elif (( RUNPOD_VOLUME_GB > 0 )); then
    create_args+=(--volume-in-gb "$RUNPOD_VOLUME_GB" --volume-mount-path /workspace)
  fi
  [[ -z "$RUNPOD_REGISTRY_AUTH_ID" ]] || create_args+=(--registry-auth-id "$RUNPOD_REGISTRY_AUTH_ID")

  started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  note "Creating $gpu with $PROFILE_ENGINE in $dc at up to \$$price/hour; minimum download: ${RUNPOD_MIN_DOWNLOAD_MBPS} Mbps; hard termination: $terminate_after"
  pod_name=$RUNPOD_POD_NAME
  (( RUNPOD_MIN_DOWNLOAD_MBPS == 0 )) || pod_name="${RUNPOD_POD_NAME}-$(date -u +%Y%m%d%H%M%S)-$$"
  create_error=$(mktemp "$STATE_DIR/create.XXXXXX")
  trap 'rc=$?; trap - EXIT; rm -f "${create_error:-}"; if (( rc != 0 )) && [[ -r "$STATE_FILE" ]] && [[ -n "$(pod_id || true)" ]]; then note "Startup failed; capturing logs before termination."; capture_startup_failure; down || true; fi; exit "$rc"' EXIT
  if (( RUNPOD_MIN_DOWNLOAD_MBPS > 0 )); then
    write_state "$(jq -cn --arg name "$pod_name" --arg started "$started" --arg terminate "$terminate_after" \
      '{pod_id:null,pending_pod_name:$name,started_at:$started,terminate_after:$terminate}')"
    output=$(create_pod_graphql "$gpu" "$dc" "$terminate_after" "$env_json" "$pod_name" 2>"$create_error") || {
      error_json=$(jq -Rn '[inputs | fromjson? | select(type == "object")] | first // {}' < "$create_error")
      error_code=$(jq -r '.code // "unknown"' <<< "$error_json")
      if [[ "$error_code" == graphql_ambiguous ]]; then
        if reconcile_graphql_create "$pod_name"; then
          rm -f "$STATE_FILE"
        else
          note "Could not rule out a created Pod; pending state is retained for cleanup."
        fi
      else
        rm -f "$STATE_FILE"
      fi
      die "Pod creation failed ($error_code): $(jq -r '.error // "unknown error"' <<< "$error_json")"
    }
  elif ! output=$(runpod "${create_args[@]}" 2>"$create_error"); then
    error_json=$(jq -Rn '[inputs | fromjson? | select(type == "object")] | first // {}' < "$create_error")
    id=$(jq -r '.id // empty' <<< "$error_json")
    error_code=$(jq -r '.code // "unknown"' <<< "$error_json")
    if [[ -n "$id" ]]; then
      write_state "$(jq -cn --arg id "$id" '{pod_id:$id,gpu:"unknown",data_center:"unknown",price_per_hour:null}')"
    fi
    die "Pod creation failed ($error_code): $(jq -r '.error // "unknown error"' <<< "$error_json")"
  fi
  rm -f "$create_error"
  id=$(jq -er '.id // .pod.id' <<< "$output") || die "Could not read Pod id from runpodctl output."
  write_state "$(jq -cn --arg id "$id" --arg gpu "$gpu" --arg dc "$dc" --argjson price "$price" \
    --arg engine "$PROFILE_ENGINE" --arg image "$PROFILE_IMAGE" --arg model "$PROFILE_MODEL" \
    --arg revision "$PROFILE_REVISION" --arg served "$PROFILE_SERVED_MODEL" \
    --argjson maxlen "$PROFILE_MAX_MODEL_LEN" --arg log_file "$PROFILE_LOG_FILE" \
    --arg started "$started" --arg terminate "$terminate_after" --argjson clinical "$RUNPOD_CLINICAL_MODE" \
      '{pod_id:$id,gpu:$gpu,data_center:$dc,price_per_hour:$price,engine:$engine,image:$image,model:$model,model_revision:$revision,served_model:$served,max_model_len:$maxlen,clinical_mode:$clinical,log_file:$log_file,started_at:$started,terminate_after:$terminate}')"

  (( RUNPOD_MIN_DOWNLOAD_MBPS == 0 )) || wait_for_ssh
  update_state '.ssh_ready_at = $ready | .ssh_ready_seconds = ((($ready | fromdateiso8601) - (.started_at | fromdateiso8601)) | floor)' \
    --arg ready "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  start_tunnel
  wait_for_server
  update_state '.ready_at = $ready | .startup_seconds = ((($ready | fromdateiso8601) - (.started_at | fromdateiso8601)) | floor)' \
    --arg ready "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  start_monitor
  trap - EXIT
  note "Ready: OpenAI-compatible API at http://127.0.0.1:${VLLM_LOCAL_PORT}/v1"
  status
}

down() {
  local id tunnel_pid monitor_pid pending terminate_epoch now
  if [[ ! -r "$STATE_FILE" ]]; then
    note "No local Pod state."
    return 0
  fi
  id=$(pod_id || true)
  pending=$(state_value '.pending_pod_name // empty' || true)
  if [[ -z "$id" && -n "$pending" ]]; then
    validate_reconcile_settings
    if reconcile_graphql_create "$pending"; then
      rm -f "$STATE_FILE"
      note "Pending GraphQL creation reconciled; no Pod remains."
      return 0
    fi
    id=$(pod_id || true)
    [[ -z "$id" ]] || die "Deletion failed for reconciled Pod $id; state retained."
    terminate_epoch=$(state_value '.terminate_after | fromdateiso8601' || printf '0')
    now=$(date +%s)
    if (( terminate_epoch > 0 && now >= terminate_epoch )) && pending_pod_absent "$pending"; then
      rm -f "$STATE_FILE"
      note "Hard termination has passed and Runpod confirms no matching Pod; local state cleared."
      return 0
    fi
    die "Could not confirm cleanup for pending Pod name $pending; state retained."
  fi
  tunnel_pid=$(state_value '.tunnel_pid // empty' || true)
  monitor_pid=$(state_value '.monitor_pid // empty' || true)
  [[ "$monitor_pid" == "$$" ]] || { pid_matches "$monitor_pid" 'opencode-gpu.*_monitor' && kill "$monitor_pid" 2>/dev/null || true; }
  pid_matches "$tunnel_pid" 'ssh.*127.0.0.1' && kill "$tunnel_pid" 2>/dev/null || true
  if [[ -n "$id" ]]; then
    note "Terminating Pod $id..."
    delete_pod "$id" || die "Runpod could not confirm termination of Pod $id; local state retained."
  fi
  rm -f "$STATE_FILE"
  note "Pod terminated and local tunnel closed."
}

status() {
  local id remote tunnel_pid monitor_pid pending matches
  if [[ ! -r "$STATE_FILE" ]]; then
    printf 'Status: down\n'
    return 0
  fi
  id=$(pod_id || true)
  pending=$(state_value '.pending_pod_name // empty' || true)
  if [[ -z "$id" && -n "$pending" ]]; then
    matches=$(runpod pod list --all 2>/dev/null | jq -c --arg name "$pending" '[.[]? | select(.name == $name)]' || printf 'null')
    jq -n --arg name "$pending" --argjson matches "$matches" \
      '{status:"creation_unknown",pending_pod_name:$name,matching_pods:$matches}'
    return 0
  fi
  tunnel_pid=$(state_value '.tunnel_pid // empty' || true)
  monitor_pid=$(state_value '.monitor_pid // empty' || true)
  remote=$(runpod pod get "$id" 2>/dev/null || true)
  jq -n \
    --argjson local "$(<"$STATE_FILE")" \
    --argjson remote "${remote:-null}" \
    --arg tunnel "$([[ -n "$tunnel_pid" ]] && pid_alive "$tunnel_pid" && printf running || printf stopped)" \
    --arg monitor "$([[ -n "$monitor_pid" ]] && pid_alive "$monitor_pid" && printf running || printf stopped)" \
    '{pod_id:$local.pod_id,clinical_mode:($local.clinical_mode // false),gpu:$local.gpu,engine:($local.engine // "vllm"),model:($local.model // null),max_model_len:($local.max_model_len // null),data_center:$local.data_center,price_per_hour:$local.price_per_hour,ssh_ready_seconds:($local.ssh_ready_seconds // null),startup_seconds:($local.startup_seconds // null),terminate_after:$local.terminate_after,tunnel:$tunnel,idle_monitor:$monitor,runpod_status:($remote.runtimeStatus // $remote.desiredStatus // "unknown")}'
}

logs() {
  local info log_file
  [[ -r "$STATE_FILE" ]] || die "No active Pod."
  info=$(ssh_info) || die "Pod SSH is unavailable."
  ssh_args "$info"
  log_file=$(state_value '.log_file // "/var/log/opencode-gpu/vllm.log"')
  ssh "${SSH_ARGS[@]}" "$SSH_TARGET" tail -n 200 -f "$log_file"
}

benchmark() {
  local info engine response payload started elapsed successful=0 completion_tokens=0 tokens
  [[ -r "$STATE_FILE" ]] || die "No active Pod."
  info=$(ssh_info) || die "Pod SSH is unavailable."
  ssh_args "$info"
  engine=$(state_value '.engine // "vllm"')
  if [[ "$engine" == vllm ]]; then
    ssh "${SSH_ARGS[@]}" "$SSH_TARGET" \
      vllm bench serve --backend openai-chat --base-url "http://127.0.0.1:${VLLM_REMOTE_PORT}" \
      --endpoint /v1/chat/completions --model "$(state_value '.served_model // empty' || printf '%s' "$VLLM_SERVED_MODEL")" \
      --tokenizer "$(state_value '.model // empty' || printf '%s' "$VLLM_MODEL")" --dataset-name random \
      --num-prompts 20 --random-input-len 256 --random-output-len 128
    return
  fi

  read_key
  payload=$(jq -cn --arg model "$(state_value '.served_model')" \
    '{model:$model,messages:[{role:"user",content:"Write a concise explanation of why immutable model revisions improve reproducibility."}],max_tokens:128,temperature:0.2}')
  started=$(date +%s)
  for _ in {1..20}; do
    response=$(curl --silent --show-error --fail --max-time 300 \
      -H "Authorization: Bearer $VLLM_API_KEY" -H 'Content-Type: application/json' \
      --data "$payload" "http://127.0.0.1:${VLLM_LOCAL_PORT}/v1/chat/completions")
    tokens=$(jq -er '.usage.completion_tokens' <<< "$response")
    successful=$((successful + 1))
    completion_tokens=$((completion_tokens + tokens))
  done
  elapsed=$(( $(date +%s) - started ))
  (( elapsed > 0 )) || elapsed=1
  jq -n --arg engine "$engine" --argjson requests "$successful" --argjson tokens "$completion_tokens" \
    --argjson elapsed "$elapsed" \
    '{engine:$engine,successful_requests:$requests,completion_tokens:$tokens,elapsed_seconds:$elapsed,output_tokens_per_second:($tokens / $elapsed)}'
}

plan() {
  local selection gpu dc price health_timeout
  require_command runpodctl
  require_command jq
  pin_to_network_volume
  selection=$(select_gpu) || {
    (( $? == 2 )) && die "In-stock preferred GPUs were found, but none has a configured immutable engine image."
    die "No preferred Secure Cloud GPU is in stock in an allowed EU/EEA datacenter below the price ceiling."
  }
  IFS=$'\t' read -r gpu dc price <<< "$selection"
  configure_profile "$gpu"
  validate_profile_image
  validate_min_download
  validate_reconcile_settings
  validate_clinical_mode
  if [[ "$PROFILE_ENGINE" == llama_cpp ]]; then
    health_timeout=$LLAMA_CPP_HEALTH_TIMEOUT_SECONDS
  else
    health_timeout=$HEALTH_TIMEOUT_SECONDS
  fi
  jq -n --arg gpu "$gpu" --arg dc "$dc" --argjson price "$price" --arg image "$PROFILE_IMAGE" \
    --arg engine "$PROFILE_ENGINE" --arg model "$PROFILE_MODEL" --arg revision "$PROFILE_REVISION" \
    --arg served "$PROFILE_SERVED_MODEL" --argjson maxlen "$PROFILE_MAX_MODEL_LEN" \
    --argjson disk "$RUNPOD_CONTAINER_DISK_GB" --argjson health_timeout "$health_timeout" \
    --argjson min_download "$RUNPOD_MIN_DOWNLOAD_MBPS" \
    --argjson clinical "$RUNPOD_CLINICAL_MODE" \
    --argjson max_minutes "$RUNPOD_MAX_SESSION_MINUTES" --arg volume "$RUNPOD_NETWORK_VOLUME_ID" \
    --arg volume_dc "${NETWORK_VOLUME_DC:-}" --argjson volume_size "${NETWORK_VOLUME_SIZE_GB:-null}" \
    '{billable_resource_created:false,clinical_mode:($clinical == 1),gpu:$gpu,data_center:$dc,secure_cloud:true,price_per_hour:$price,engine:$engine,container_disk_gb:$disk,min_download_mbps:$min_download,startup_timeout_seconds:$health_timeout,max_session_minutes:$max_minutes,image:$image,model:$model,model_revision:$revision,served_model:$served,max_model_len:$maxlen,network_volume:(if $volume == "" then null else {id:$volume,data_center:$volume_dc,size_gb:$volume_size,mount_access:"read-write",purpose:(if $clinical == 1 then "model-cache-only" else "unrestricted" end),inference_access:(if $clinical == 1 then "read-only" else "read-write" end)} end)}'
}

monitor() {
  local idle_seconds=$((VLLM_IDLE_MINUTES * 60)) last_activity now metrics total previous_total=-1 running failures=0 tunnel_pid engine
  [[ -r "$STATE_FILE" ]] || exit 0
  read_key
  engine=$(state_value '.engine // "vllm"')
  last_activity=$(date +%s)
  note "Idle monitor started; timeout ${VLLM_IDLE_MINUTES} minutes."
  while [[ -r "$STATE_FILE" ]]; do
    sleep "$MONITOR_INTERVAL_SECONDS"
    tunnel_pid=$(state_value '.tunnel_pid // empty' || true)
    if ! pid_matches "$tunnel_pid" 'ssh.*127.0.0.1'; then
      note "SSH tunnel stopped; terminating Pod."
      "$0" down
      exit 0
    fi
    if ! metrics=$(curl --silent --fail --max-time 10 -H "Authorization: Bearer $VLLM_API_KEY" \
      "http://127.0.0.1:${VLLM_LOCAL_PORT}/metrics" 2>/dev/null); then
      ((failures += 1))
      if (( failures >= 5 )); then
        note "$engine metrics unavailable for five checks; terminating Pod."
        "$0" down
        exit 0
      fi
      continue
    fi
    failures=0
    if [[ "$engine" == llama_cpp ]]; then
      total=$(awk '/^llamacpp:(prompt_tokens_total|tokens_predicted_total) /{sum += $NF} END {print sum + 0}' <<< "$metrics")
      running=$(awk '/^llamacpp:requests_(processing|deferred) /{sum += $NF} END {print sum + 0}' <<< "$metrics")
    else
      total=$(awk '/^vllm:request_success_total(\{| )/{sum += $NF} END {print sum + 0}' <<< "$metrics")
      running=$(awk '/^vllm:num_requests_(running|waiting)(\{| )/{sum += $NF} END {print sum + 0}' <<< "$metrics")
    fi
    now=$(date +%s)
    if [[ "$previous_total" == -1 || "$total" != "$previous_total" ]] || \
       awk -v n="$running" 'BEGIN {exit !(n > 0)}'; then
      last_activity=$now
      previous_total=$total
    fi
    if (( now - last_activity >= idle_seconds )); then
      note "No inference activity for ${VLLM_IDLE_MINUTES} minutes; terminating Pod."
      "$0" down
      exit 0
    fi
  done
}

session() {
  "$0" up
  trap '"$0" down' EXIT INT TERM HUP
  OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_PURE=1 opencode --agent private-gpu "$@"
}

locked() {
  require_command flock
  mkdir -p "$STATE_DIR"
  exec flock --close --exclusive --wait 10 "$LOCK_FILE" "$0" "$1"
}

usage() {
  cat <<EOF
Usage: $PROGRAM {plan|up|down|status|logs|benchmark|session}

  plan       Show placement and price without creating a resource
  up         Create the Pod, tunnel the selected server, and start the idle monitor
  down       Terminate the Pod and close the tunnel
  status     Show local and Runpod status
  logs       Follow remote inference-server logs
  benchmark  Run a small serving benchmark on the Pod
  session    Run a private OpenCode TUI and terminate the Pod on exit
EOF
}

case "${1:-}" in
  plan) plan ;;
  up) locked _up ;;
  down) locked _down ;;
  _up) up ;;
  _down) down ;;
  status) status ;;
  logs) logs ;;
  benchmark) benchmark ;;
  session) shift; session "$@" ;;
  _monitor) monitor ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
