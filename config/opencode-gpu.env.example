# Copy to ~/.config/opencode-gpu/config and adjust before provisioning.
RUNPOD_POD_NAME=opencode-private-gpu
RUNPOD_IMAGE=ghcr.io/palantre/opencode-private-vllm@sha256:dd03e2586a71f7e5a75f230cc5255cb579b2f1e4b2e1fd40f7d9d712486ab431
RUNPOD_REGISTRY_AUTH_ID=
RUNPOD_GPU_IDS='NVIDIA L40S,NVIDIA L40,NVIDIA RTX 6000 Ada Generation'

# Leave empty to select an in-stock allowed EU/EEA datacenter. Set this to pin
# placement; network volumes are always pinned to their own datacenter.
RUNPOD_DATA_CENTER_IDS=
RUNPOD_ALLOWED_DC_PREFIXES='EU-,EUR-'
RUNPOD_NETWORK_VOLUME_ID=

RUNPOD_CONTAINER_DISK_GB=80
RUNPOD_VOLUME_GB=0
RUNPOD_MAX_SESSION_MINUTES=240
RUNPOD_MAX_PRICE_PER_HOUR=1.50

VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
VLLM_IDLE_MINUTES=30
