#!/usr/bin/env bash
set -euo pipefail

printf '%q ' "$@" >> "$MOCK_LOG"
printf '\n' >> "$MOCK_LOG"

case "$1 $2" in
  'gpu list')
    case "${MOCK_GPU_SCENARIO:-default}" in
      llama)
        cat <<'JSON'
[
  {
    "gpuId": "NVIDIA GeForce RTX 4090",
    "secureCloud": true,
    "securePricePerHr": 0.74,
    "dataCenterAvailability": [{"dataCenterId": "EUR-IS-2", "stockStatus": "High"}]
  },
  {
    "gpuId": "NVIDIA GeForce RTX 5090",
    "secureCloud": true,
    "securePricePerHr": 0.99,
    "dataCenterAvailability": [{"dataCenterId": "EU-CZ-1", "stockStatus": "Low"}]
  }
]
JSON
        ;;
      a100)
        cat <<'JSON'
[
  {
    "gpuId": "NVIDIA A100 80GB PCIe",
    "secureCloud": true,
    "securePricePerHr": 1.39,
    "dataCenterAvailability": [{"dataCenterId": "EU-RO-1", "stockStatus": "Low"}]
  }
]
JSON
        ;;
      pro6000-mig)
        cat <<'JSON'
[
  {
    "gpuId": "NVIDIA RTX PRO 6000 Blackwell Server Edition MIG 2g.48gb",
    "secureCloud": true,
    "securePricePerHr": 1.09,
    "dataCenterAvailability": [{"dataCenterId": "EUR-IS-2", "stockStatus": "Low"}]
  }
]
JSON
        ;;
      pro4500)
        cat <<'JSON'
[
  {
    "gpuId": "NVIDIA RTX PRO 4500 Blackwell",
    "secureCloud": true,
    "securePricePerHr": 0.72,
    "dataCenterAvailability": [{"dataCenterId": "EU-RO-1", "stockStatus": "Medium"}]
  }
]
JSON
        ;;
      llama-a100)
        cat <<'JSON'
[
  {
    "gpuId": "NVIDIA GeForce RTX 5090",
    "secureCloud": true,
    "securePricePerHr": 0.99,
    "dataCenterAvailability": [{"dataCenterId": "EU-CZ-1", "stockStatus": "Low"}]
  },
  {
    "gpuId": "NVIDIA A100 80GB PCIe",
    "secureCloud": true,
    "securePricePerHr": 1.39,
    "dataCenterAvailability": [{"dataCenterId": "EU-RO-1", "stockStatus": "Low"}]
  }
]
JSON
        ;;
      default)
        cat <<'JSON'
[
  {
    "gpuId": "NVIDIA L40",
    "secureCloud": true,
    "securePricePerHr": 1.10,
    "dataCenterAvailability": [
      {"dataCenterId": "US-KS-2", "stockStatus": "High"},
      {"dataCenterId": "EUR-IS-2", "stockStatus": "Medium"}
    ]
  },
  {
    "gpuId": "NVIDIA GeForce RTX 4090",
    "secureCloud": true,
    "securePricePerHr": 0.74,
    "dataCenterAvailability": [{"dataCenterId": "EUR-IS-2", "stockStatus": "High"}]
  },
  {
    "gpuId": "NVIDIA RTX 6000 Ada Generation",
    "secureCloud": true,
    "securePricePerHr": 0.84,
    "dataCenterAvailability": [{"dataCenterId": "EUR-IS-2", "stockStatus": "Medium"}]
  },
  {
    "gpuId": "NVIDIA L40S",
    "secureCloud": true,
    "securePricePerHr": 0.99,
    "dataCenterAvailability": [{"dataCenterId": "EUR-IS-2", "stockStatus": "Low"}]
  }
]
JSON
        ;;
      *)
        printf 'Unknown mock GPU scenario: %s\n' "$MOCK_GPU_SCENARIO" >&2
        exit 1
        ;;
    esac
    ;;
  'network-volume get')
    printf '%s\n' '{"id":"mock-volume-123","name":"model-cache","size":50,"dataCenterId":"EUR-IS-2"}'
    ;;
  'pod create')
    if [[ "${MOCK_CREATE_FAIL:-0}" == 1 ]]; then
      printf '%s\n' '{"error":"timed out waiting for ssh","code":"wait_timeout","id":"mock-pod-timeout"}' >&2
      exit 1
    fi
    printf '%s\n' '{"id":"mock-pod-123","runtimeStatus":"running"}'
    ;;
  'ssh info')
    printf '%s\n' '{"id":"mock-pod-123","ip":"192.0.2.10","port":22022,"ssh_key":{}}'
    ;;
  'pod get')
    printf '%s\n' '{"id":"mock-pod-123","runtimeStatus":"running"}'
    ;;
  'pod list')
    if [[ "${MOCK_LIST_FAIL:-0}" == 1 ]]; then
      printf '%s\n' '{"error":"temporary list failure","code":"network_error"}' >&2
      exit 1
    fi
    if [[ "${MOCK_GRAPHQL_AMBIGUOUS:-0}" == 1 ]]; then
      count=0
      [[ ! -r "$MOCK_LIST_COUNT" ]] || count=$(<"$MOCK_LIST_COUNT")
      count=$((count + 1))
      printf '%s\n' "$count" > "$MOCK_LIST_COUNT"
      if (( count <= ${MOCK_LIST_HIDDEN_ATTEMPTS:-0} )); then
        printf '%s\n' '[]'
        exit 0
      fi
      name=$(jq -r '.variables.input.name' "$MOCK_GRAPHQL_LOG")
      jq -cn --arg name "$name" '[{id:"mock-pod-123",name:$name,runtimeStatus:"running"}]'
    else
      printf '%s\n' '[]'
    fi
    ;;
  'pod delete')
    if [[ "${MOCK_DELETE_FAIL:-0}" == 1 ]]; then
      printf '%s\n' '{"error":"temporary delete failure","code":"network_error"}' >&2
      exit 1
    fi
    if [[ "${MOCK_DELETE_NOT_FOUND:-0}" == 1 ]]; then
      printf '%s\n' '{"error":"pod not found","code":"not_found"}' >&2
      exit 1
    fi
    : > "$MOCK_DELETED"
    printf '%s\n' '{"id":"mock-pod-123","runtimeStatus":"terminated"}'
    ;;
  *)
    printf 'Unexpected mock runpodctl call: %s\n' "$*" >&2
    exit 1
    ;;
esac
